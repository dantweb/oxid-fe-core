{
  "name": "@dantweb/oxid-fe-core",
  "version": "0.11.0",
  "description": "Shared Vue 3 library and TypeScript SDK for OXID headless frontends: GraphQL client, JWT auth, plugin system, guards, stores, validation.",
  "license": "BUSL-1.1",
  "type": "module",
  "files": [
    "dist",
    "theme-tools"
  ],
  "main": "./dist/oxid-fe-core.js",
  "module": "./dist/oxid-fe-core.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/oxid-fe-core.js"
    },
    "./zod-csp": {
      "types": "./dist/types/validation/zodCsp.d.ts",
      "import": "./dist/zod-csp.js"
    },
    "./styles/variables.css": "./dist/styles/variables.css",
    "./styles/components.css": "./dist/styles/components.css",
    "./theme-tools": {
      "types": "./theme-tools/index.d.mts",
      "import": "./theme-tools/index.mjs"
    }
  },
  "bin": {
    "oxfe-build-themes": "./theme-tools/cli.mjs"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "vite build && tsc -p tsconfig.build.json && mkdir -p dist/styles && cp src/styles/variables.css src/styles/components.css dist/styles/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "knip": "knip",
    "evaluate": "node scripts/evaluate.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "pinia": "^2.2.0 || ^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "dependencies": {
    "less": "^4.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "happy-dom": "^21.0.4",
    "knip": "^6.41.0",
    "pinia": "^3.0.1",
    "prettier": "^3.5.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^5.0.5",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.0"
  }
}
