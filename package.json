{
  "name": "@dantweb/oxid-fe-core",
  "version": "0.3.0",
  "description": "Shared Vue 3 library and TypeScript SDK for OXID headless frontends: GraphQL client, JWT auth, plugin system, guards, stores, validation.",
  "license": "BUSL-1.1",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/oxid-fe-core.js",
  "module": "./dist/oxid-fe-core.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/oxid-fe-core.js"
    },
    "./styles/variables.css": "./dist/styles/variables.css"
  },
  "scripts": {
    "build": "vite build && mkdir -p dist/styles && cp src/styles/variables.css dist/styles/variables.css",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "knip": "knip",
    "evaluate": "node scripts/evaluate.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "pinia": "^2.2.0 || ^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "happy-dom": "^17.1.0",
    "knip": "^5.44.0",
    "pinia": "^3.0.1",
    "prettier": "^3.5.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.0.5",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.0"
  }
}
